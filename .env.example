# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon（または publishable）キー。ブラウザに出てもよいキー
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role（または secret）キー。サーバー専用。絶対に公開しない
SUPABASE_SERVICE_ROLE_KEY=

# 匿名ID（anon_tag）を作るための秘密のソルト。長いランダム文字列にする
#   例: openssl rand -base64 32
ANON_ID_SALT=

# 管理者のメールアドレス（カンマ区切りで複数可）
ADMIN_EMAILS=

# Google ログインのボタンを出すなら true（Supabase 側で Google プロバイダの設定が必要）
NEXT_PUBLIC_GOOGLE_LOGIN=false
